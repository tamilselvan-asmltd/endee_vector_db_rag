# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_LLM_MODEL=gpt-oss:120b-cloud

# Endee Database Configuration
#ENDEE_URL=http://localhost:8080/api/v1
ENDEE_URL=http://localhost:8080
ENDEE_INDEX_NAME=cnc_hybrid_vdb

# RAG Settings
TOP_K=5
DOC_SERVER_URL=http://localhost:8003
NLTK_DATA_PATH=./nltk_data

# Redis Semantic Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_INDEX_NAME=semantic_cache_idx
SEMANTIC_CACHE_PREFIX=sem_cache:

# Redis Chat History
REDIS_CHAT_HISTORY_PREFIX=chat:
MAX_HISTORY_MESSAGES=10

# Redis Embedding Cache
REDIS_EMBED_CACHE_PREFIX=embed_cache:
EMBED_CACHE_TTL=604800

# LangGraph Agent Settings
AGENT_LLM_MODEL=gpt-oss:120b-cloud
AGENT_LLM_TEMPERATURE=0.0
AGENT_OLLAMA_URL=http://localhost:11434
AGENT_CHECKPOINTER_TYPE=sqlite
AGENT_SQLITE_CHECKPOINT_PATH=./agent_memory.db
AGENT_HEALTH_DB_PATH=./config/health.db
AGENT_SQL_MAX_ROWS=100
AGENT_TABLE_WHITELIST=["daily_body_metrics","users"]
AGENT_AUDIT_LOG_ENABLED=true
AGENT_AUDIT_LOG_PATH=./agent_audit.log
